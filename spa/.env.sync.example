# Copy this file to .env.production.local before building the SPA for release.
# Upload requires a fine-grained GitHub token. Download works without token for public repo files.

VITE_SYNC_GITHUB_OWNER=FoggyGoofball
VITE_SYNC_GITHUB_REPO=reelview-sync-data
VITE_SYNC_GITHUB_BRANCH=main
VITE_SYNC_GITHUB_PATH_PREFIX=history-sync
VITE_SYNC_GITHUB_TOKEN=
