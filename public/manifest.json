{
  "manifest_version": 3,
  "name": "ReelView Extension",
  "version": "1.0",
  "description": "Provides native pop-up blocking for the ReelView application.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
